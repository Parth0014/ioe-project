{
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}\\.venv-cloud\\Scripts;${workspaceFolder}\\.python\\cpython-3.12.8-windows-x86_64-none;${env:PATH}"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "C_Cpp.errorSquiggles": "disabled",
  "liveServer.settings.ignoreFiles": [
    "**/.vscode/**",
    "**/.git/**",
    "**/.venv*/**",
    "**/.python/**",
    "**/.npm-cache/**",
    "**/.uv-cache/**",
    "**/.playwright-cli/**",
    "**/.godmode/**",
    "**/.gravitas/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/energy.sqlite3*",
    "**/.env*",
    "**/output/**",
    "**/public/static/**"
  ],
  "files.watcherExclude": {
    "**/.venv*/**": true,
    "**/.python/**": true,
    "**/.npm-cache/**": true,
    "**/.uv-cache/**": true,
    "**/__pycache__/**": true,
    "**/output/**": true,
    "**/energy.sqlite3*": true
  }
}
